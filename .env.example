# Copy to .env for local development, then fill these locally. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_SERVICE_TOKEN=
MAX_UPLOAD_BYTES=10485760
# Clamped to 5000-75000 ms.
GEMINI_TIMEOUT_MS=60000
# Clamped to 5000-30000 characters.
MAX_EXTRACTED_CHARS=30000
# 1-3 attempts; only rate limits and timeouts are retried.
GENERATION_ATTEMPTS=2
# 0 disables the in-memory cache of repeated requests.
GENERATION_CACHE_ENTRIES=32
